# Copy to .env and fill the lines marked 필수. .env is ignored by git — never commit it.
#   cp .env.example .env

# ---- 필수: AI 키 (정비 진단 · AgentOps 평가 · 개선이 모델을 부름 — 각자 키 · 쓴 만큼 요금)
OPENAI_API_KEY=

# ---- 필수: 비밀번호 (아무 긴 글자로 바꾸세요 · 처음 켤 때 DB가 이 값으로 만들어짐 · 나중에 바꾸면 DB를 처음부터 다시)
TRACE_DB_PASSWORD=change-me-trace
POSTGRES_PASSWORD=change-me-app
C1A15_TECH_PASSWORD=change-me-tech
C1A15_LEAD_PASSWORD=change-me-lead
C1A15_INTERNAL_TOKEN=change-me-internal
NEO4J_AUTH=neo4j/change-me-graph

# ---- 선택: 키를 이 파일에 적지 않고 키 파일 경로로 줄 때(서버 등 · 설치 안내 11) — 아래 두 줄을 켜고 OPENAI_API_KEY= 는 비워 둠
#   COMPOSE_FILE을 여기 두면 모든 docker compose 명령과 scripts/ 대본이 키 파일 설정을 함께 씀(한 명령에만 -f를 붙이면 다음 다시 켜기에서 키가 빠짐)
# COMPOSE_FILE=docker-compose.yml:compose.key-file.yml
# OPENAI_KEY_FILE=/home/ec2-user/openai.key

# ---- Jev 키: 효율 개선(설치 안내 08)의 ⑤ 품질 검토가 부름 — 없으면 출력이 바뀐 후보(08 ②)가 ⑤에서 멈춤(decide_no_key_file) → 키를 넣거나 아래 LLMOPS_AUTO_REVIEW=off · 정확도(07)까지는 없어도 됨
JEV_BASE_URL=
JEV_API_KEY=
#   키를 파일 경로로 줄 때: 위 JEV_API_KEY= 는 비워 두고 아래 두 줄(OpenAI 키 파일도 쓰면 COMPOSE_FILE에 셋을 이어서
#   docker-compose.yml:compose.key-file.yml:compose.jev-key-file.yml)
# COMPOSE_FILE=docker-compose.yml:compose.jev-key-file.yml
# JEV_KEY_FILE=/home/ec2-user/jev.key
# Jev 키가 없을 때 효율 개선을 품질 검토 없이 끝까지 가게 함 — 개선 기록에 '품질 검토 꺼짐'이 남음(기본 on)
# LLMOPS_AUTO_REVIEW=off

# ---- 포트 (이 컴퓨터에서 이미 쓰는 포트와 겹치면 바꾸세요 · 모두 127.0.0.1에만 열림)
TECH_PORT=8081
LEAD_PORT=8082
PACK_SERVER_PORT=8796
NEO4J_HTTP_PORT=28576
NEO4J_BOLT_PORT=28789
AGENTOPS_PORT=18868

# ---- 그 밖 (바꾸지 않아도 됨)
COMPOSE_PROJECT_NAME=lmg
LLMOPS_LLM_MODE=real
LLMOPS_AUTO_BUDGET_USD=8
DEPLOYMENT_ID=c1a15@local
FIRST_PACK_TAG=first
# 첫 상태 기준 시각(앱 시드 · 그래프가 같은 값) · 비우면 처음 켤 때의 지금 · 꼴 2026-11-11T09:00:00+09:00
AT=
