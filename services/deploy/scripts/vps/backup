#!/usr/bin/env python3
"""하루 백업(VFE EV-005 ES-C, CHG-05 · D-82 · Q-N4) — VPS에서 하루 1회(cron 자리). 표준 라이브러리만 씁니다(호스트에 venv가 없어도 됨).
  backup --dest <백업 폴더> --volume <이름>=<경로> [--volume …] [--env-file <비밀 파일>] [--dsn-env <이름>] [--keep 7] [--date YYYY-MM-DD]
      1 <dest>/<날짜>.partial/ 에 만듦
        db.dump          pg_dump -Fc 출력(DSN은 env 파일에서 읽어 PG* 환경 변수로만 넘김 — 명령줄 · 출력 · 파일 이름에 값 없음)
        volumes.tar.gz   --volume 경로들(묶음 안 이름 = 경로에서 앞 / 뺀 것 — 이름이 겹치지 않음)
        manifest.json    파일 이름 · 크기 · sha256, 볼륨 이름 → 묶음 안 경로, DSN 환경 변수 이름(값 없음), warnings
      tar 종료 1(GNU tar: 읽는 중 파일이 바뀜 — 쓰는 중인 볼륨)은 하루 실패로 버리지 않고 그 볼륨을 warnings에 적음. 2 이상은 실패.
      pg_dump · tar 오류는 마지막 몇 줄을 출력(DSN의 비밀번호 · 사용자 값은 *** 로 가림)
      2 성공하면 <날짜>로 이름 바꿈(같은 날짜가 있으면 바꿔 씀). 실패하면 .partial을 지우고 종료 1 — 지난 백업은 그대로
      3 성공 뒤에만 <dest> 바로 아래 날짜 폴더(YYYY-MM-DD, 링크 아님) 중 최근 --keep개만 남기고 지움. 그 밖의 것은 건드리지 않음
볼륨 목록은 인자로 받습니다(llmops-data 포함 여부는 ES-G 전에 llmops · 오케와 정함, 계약 CHG-05 N4).
바꿀 수 있는 명령(시험은 가짜): BACKUP_PG_DUMP(기본 = compose exec로 postgres 컨테이너 안 pg_dump, 바깥 포트 없음 — 계약 N5), BACKUP_TAR(기본 "tar").
종료: 0 완료 / 1 실패(지난 백업 그대로) / 2 사용 오류(아무것도 쓰지 않음)."""
import argparse
import datetime
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import urllib.parse
from pathlib import Path

HERE = Path(__file__).resolve().parents[2]
DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")
NAME_RE = re.compile(r"^[a-z0-9][a-z0-9_.\-]{0,63}$")
PG_NAMES = ("PGHOST", "PGPORT", "PGUSER", "PGPASSWORD", "PGDATABASE")
DEFAULT_PG_DUMP = (f"docker compose -f {shlex.quote(str(HERE / 'docker' / 'compose.yaml'))} exec -T "
                   + " ".join(f"-e {n}" for n in PG_NAMES) + " postgres pg_dump")   # -e 이름만 = 값은 이 프로세스 환경에서 넘어감


def out(msg):
    print(msg, flush=True)


def cmd(env, default):
    return shlex.split(os.environ.get(env) or default)


def read_env_value(path, name):
    """env 파일에서 한 이름의 값만 읽는다(다른 줄은 보지 않음). deploy_server.execution.read_env_value와 같은 규칙."""
    if not path or not os.path.isfile(path):
        return None
    with open(path, encoding="utf-8") as f:
        for line in f:
            k, sep, v = line.strip().partition("=")
            if sep and k.strip() == name:
                v = v.strip()
                if len(v) >= 2 and v[0] == v[-1] and v[0] in "'\"":
                    v = v[1:-1]
                return v or None
    return None


def pg_env(dsn):
    """postgresql://user:pw@host:port/db → PG* 환경 변수. 값은 어디에도 출력하지 않는다."""
    u = urllib.parse.urlsplit(dsn)
    try:
        port = u.port
    except ValueError:
        return None
    if u.scheme not in ("postgresql", "postgres") or not u.hostname or not u.username or not u.path.strip("/"):
        return None
    env = {"PGHOST": u.hostname, "PGPORT": str(port or 5432), "PGUSER": urllib.parse.unquote(u.username),
           "PGDATABASE": urllib.parse.unquote(u.path.strip("/"))}
    if u.password is not None:
        env["PGPASSWORD"] = urllib.parse.unquote(u.password)
    return env


def tail(text, env, n=3):
    """오류 출력 끝 n줄. PG* 값(비밀번호 · 사용자 · 호스트 · DB)은 *** 로 가린다."""
    for v in sorted((v for v in env.values() if v and len(v) >= 3), key=len, reverse=True):
        text = text.replace(v, "***")
    lines = [l for l in text.strip().splitlines() if l.strip()]
    return " | ".join(lines[-n:])[:400] or "(출력 없음)"


def sha256(p):
    h = hashlib.sha256()
    with open(p, "rb") as f:
        for b in iter(lambda: f.read(1 << 20), b""):
            h.update(b)
    return h.hexdigest()


def date_dirs(dest):
    return sorted(p for p in dest.iterdir() if DATE_RE.fullmatch(p.name) and p.is_dir() and not p.is_symlink())


def prune(dest, keep, made):
    """dest 바로 아래 날짜 폴더 중 최근 keep개만 남김(방금 만든 made는 늘 남김). 링크 · 다른 이름 · dest 밖은 건드리지 않음."""
    gone = []
    root = dest.resolve()
    others = [p for p in date_dirs(dest) if p.name != made]
    for p in others[:max(len(others) - (keep - 1), 0)]:
        if p.resolve().parent != root:
            continue
        shutil.rmtree(p)
        gone.append(p.name)
    return gone


def backup(a):
    dest = Path(a.dest)
    vols = []
    for v in a.volume:
        name, sep, path = v.partition("=")
        if not sep or not NAME_RE.fullmatch(name) or not Path(path).is_absolute() or not Path(path).is_dir():
            print(f"사용 오류: --volume 이름=절대 경로(있는 폴더): {name or v!r}", file=sys.stderr)
            return 2
        if any(name == n for n, _ in vols):
            print(f"사용 오류: --volume 이름이 두 번: {name}", file=sys.stderr)
            return 2
        vols.append((name, Path(path)))
    dsn = os.environ.get(a.dsn_env) or read_env_value(a.env_file, a.dsn_env)
    env = pg_env(dsn) if dsn else None
    if not env:
        print(f"사용 오류: {a.dsn_env}를 환경 변수나 env 파일에서 읽지 못했거나 postgresql:// 모양이 아님(값은 출력하지 않음)", file=sys.stderr)
        return 2
    if not dest.is_dir():
        print(f"사용 오류: 백업 폴더가 없음: {dest}", file=sys.stderr)
        return 2
    day = a.date or datetime.date.today().isoformat()
    work, final = dest / f"{day}.partial", dest / day
    if final.is_symlink() or (final.exists() and not final.is_dir()):
        print(f"사용 오류: {day} 자리에 폴더가 아닌 것(링크 · 파일)이 있음 — 손대지 않음", file=sys.stderr)
        return 2
    if work.exists():
        shutil.rmtree(work)
    work.mkdir(mode=0o700)
    try:
        out(f"[1/3] pg_dump → {day}/db.dump (DSN 환경 변수 {a.dsn_env}, 값 출력 없음)")
        with open(work / "db.dump", "wb") as f:
            r = subprocess.run([*cmd("BACKUP_PG_DUMP", DEFAULT_PG_DUMP), "--format=custom", "--no-password"],
                               stdout=f, stderr=subprocess.PIPE,
                               env={**{k: v for k, v in os.environ.items() if k not in PG_NAMES}, **env})   # 호스트에 남은 PG* 값은 넘기지 않음
        if r.returncode:
            raise RuntimeError(f"pg_dump 종료 {r.returncode}: {tail(r.stderr.decode('utf-8', 'replace'), env)}")
        members = {name: str(path.resolve()).lstrip("/") for name, path in vols}
        out(f"[2/3] 볼륨 묶음 → {day}/volumes.tar.gz ({', '.join(members) or '없음'})")
        warnings = []
        if vols:
            r = subprocess.run([*cmd("BACKUP_TAR", "tar"), "-czf", str(work / "volumes.tar.gz"), "-C", "/", *members.values()],
                               capture_output=True, text=True)
            if r.returncode == 1 and (work / "volumes.tar.gz").is_file():
                hit = [n for n, m in members.items() if m in r.stderr] or ["(볼륨 알 수 없음)"]
                warnings = [{"volume": n, "what": "tar 종료 1 — 읽는 중 바뀐 파일(쓰는 중인 볼륨)"} for n in hit]
                out(f"  경고: tar 종료 1 — {', '.join(hit)}: {tail(r.stderr, env)}")
            elif r.returncode:
                raise RuntimeError(f"tar 종료 {r.returncode}: {tail(r.stderr, env)}")
        files = [{"name": p.name, "bytes": p.stat().st_size, "sha256": sha256(p)} for p in sorted(work.iterdir())]
        manifest = {"date": day, "created_at": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
                    "dsn_env": a.dsn_env, "volumes": members, "files": files, "warnings": warnings}
        (work / "manifest.json").write_text(json.dumps(manifest, ensure_ascii=False, indent=1) + "\n", encoding="utf-8")
    except (RuntimeError, OSError) as e:
        shutil.rmtree(work, ignore_errors=True)
        out(f"결과: 실패 — {e}. 지난 백업은 그대로")
        return 1
    if final.exists():
        shutil.rmtree(final)
    work.rename(final)
    gone = prune(dest, a.keep, day)
    out(f"[3/3] 남김 {len(date_dirs(dest))}개, 지움 {len(gone)}개{(' (' + ', '.join(gone) + ')') if gone else ''}")
    out(f"결과: 완료{' (경고 ' + str(len(warnings)) + ')' if warnings else ''} {final}")
    return 0


def main(argv=None):
    ap = argparse.ArgumentParser(prog="backup")
    ap.add_argument("--dest", required=True)
    ap.add_argument("--volume", action="append", default=[])
    ap.add_argument("--env-file", default="/srv/llmopsagent/env/backup.env")
    ap.add_argument("--dsn-env", default="LLMOPSAGENT_BACKUP_DSN")
    ap.add_argument("--keep", type=int, default=7)
    ap.add_argument("--date")
    a = ap.parse_args(argv)
    if a.date and not DATE_RE.fullmatch(a.date) or a.keep < 1 or not re.fullmatch(r"[A-Z][A-Z0-9_]+", a.dsn_env):
        print("사용 오류: --date YYYY-MM-DD · --keep 1 이상 · --dsn-env 이름", file=sys.stderr)
        return 2
    return backup(a)


if __name__ == "__main__":
    sys.exit(main())
