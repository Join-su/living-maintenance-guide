def before_reconfigure(config):
    p = Path(config)
    return p.with_name(f".{p.name}.before-reconfigure")


def inner_reconfigure_apply(a):
    """D-375 안쪽: 템플릿 + 지금 expect_revision → 같은 배포 id · Pack 저장소 · ref · revision인지 → 묶기 대조 → 옛 글 보관 · 운영 설정 바꿈."""
    live, tmpl = Path(a.config), Path(a.template)
    if not live.is_file():
        out(f"멈춤: 운영 설정 {live}이 없음 — register로 먼저(손 0)")
        return 1
    if not tmpl.is_file():
        out(f"멈춤: 템플릿 {tmpl}이 없음(이미지 config/) — 손 0")
        return 1
    m = REV_LINE.search(live.read_text(encoding="utf-8"))
    if not m:
        out("멈춤: 운영 설정에 expect_revision이 없음 — register를 마친 설정만 바꿈(손 0)")
        return 1
    cand = live.with_name(f".{live.name}.reconfigure-candidate")
    try:
        atomic_write(cand, tmpl.read_text(encoding="utf-8"))
        fill_expect_revision(cand, m.group(1))
        if cand.read_text(encoding="utf-8") == live.read_text(encoding="utf-8"):
            print(RECONF_MARK + json.dumps({"status": "same"}))
            return 0
        old, new = inner_settings(str(live)), inner_settings(str(cand))
        for what, x, y in (("배포 id", old.deployment_id, new.deployment_id), ("Pack 저장소", str(old.pack_repo), str(new.pack_repo)),
                           ("Pack ref", old.pack_ref, new.pack_ref), ("expect_revision", old.expect_revision, new.expect_revision)):
            if x != y:
                out(f"멈춤: 템플릿의 {what}이 운영 설정과 다름({x} / {y}) — reconfigure는 같은 버전 · 같은 장부 줄만(새 버전은 register · switch)")
                return 1
        out("[1/4] 묶기 대조(바꿀 설정 — packrt가 이 설정으로 시작할 수 있는지 · DB store면 DB도)")
        r = run([*cmd("DEPLOY_CHECK_BIND", f"{shlex.quote(sys.executable)} {shlex.quote(str(HERE / 'scripts' / 'r12-update'))}"), "check", "--config", str(cand)])
        out(r.stdout.strip())
        if r.returncode:
            out(f"멈춤: 묶기 대조 실패 — 운영 설정 그대로{(' · ' + last_line(r.stderr)) if r.stderr.strip() else ''}")
            return 1
        keep = before_reconfigure(live)
        atomic_write(keep, live.read_text(encoding="utf-8"))
        atomic_write(live, cand.read_text(encoding="utf-8"))
        print(RECONF_MARK + json.dumps({"status": "changed", "before": keep.name}, ensure_ascii=False))
        return 0
    finally:
        cand.unlink(missing_ok=True)


def inner_reconfigure_revert(a):
    keep = before_reconfigure(a.config)
    if not keep.is_file():
        out(f"멈춤: 옛 글 {keep.name}이 없음 — 되돌릴 수 없음")
        return 1
    atomic_write(a.config, keep.read_text(encoding="utf-8"))
    out(f"되돌림: {Path(a.config).name} ← {keep.name}")
    return 0


