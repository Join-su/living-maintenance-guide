#!/usr/bin/env python3
"""배포 승인 ③ 등록 · ④ 운영 전환 · 운영 되돌리기 확인 스크립트(VFE EV-005 ES-B · ES-G0 · ES-R, CHG-04 · CHG-09 · D-61 · D-140) — 사용자가 VPS 호스트에서 한 줄로 실행합니다.
10-15 실제 배포 때 deploy 세션이 손으로 한 순서(EV-002 ES-2 ~ ES-4)를 묶을 뿐, 판단 규칙은 그 도구들 그대로입니다.

두 자리로 나뉩니다(GAP-007 B):
  호스트 쪽(기본) — 표준 라이브러리만(`python3 -I -S`로도 돎). compose 조작(ps · build · up · stop), 응답 기다리기, C01 HTTP.
  안쪽(--inner)   — 서버와 같은 deploy 이미지의 일회용 컨테이너 deploy-tools(또는 새 서비스 안). V-17 · V-04 · deploy-status 등 판단 코드.

  register --id <change id> --version <V2> --tag <v2> --commit <40자> --revision <sha256:…> --config <config-live/설정> --status-dir <상태 폴더>
           [--template <config/설정>] [--drs <drs:…>]
      (deploy-tools 안) 0 운영 설정이 없으면 이미지의 설정(--template)을 복사   1 git fetch --tags(열쇠 ②)   2 V-17(실패면 상태 파일 안 씀, ③ 대기)
                        3 묶기 대조 `scripts/r12-update check`(D-291 덧 · D-323 U-4 — 실패면 상태 파일 안 씀, ③ 대기. PostgreSQL store면 DB도 봄)
                        4 운영 설정에만 expect_revision   5 V-04 → registered / failed "배포단 등록 실패 — …"
  seed --config <config-live/설정> --template <config/설정>
      (deploy-tools 안) 값(expect_revision)이 이미 든 이미지 설정을 운영 설정으로 복사만. 있으면 덮지 않음, 상태 파일은 쓰지 않음(VPS 첫 기동 · v0 되돌리기)
  switch --id <change id> --version <V2> --config <config-live/설정> --status-dir <상태 폴더> --service <새 서비스> [--old-service <옛 서비스>]
         [--url <새 서버 주소>] [--case-file <C01 입력 JSON>]
      1 첫 확인(deploy-tools): registered · 같은 배포 id · 운영 설정 expect_revision = 상태 파일 revision(N4) — 아니면 아무것도 하지 않음
      2 새 서비스 빌드 · 기동(빌드 전 DEPLOY_TAG · PACKRT_TAG · DEPLOY_COMMIT(40자) 확인 — 빌드가 F-10 ① ② 대조)   3 C01 입력(새 서비스 안) → C01 HTTP(호스트)
      4 switched 기록(새 서비스 안 — 그 서버 data_dir에서 run 확인)   5 그 뒤에만 옛 서비스 내림(Q-N5)
      실패면 failed "운영 전환 실패 — …"(deploy-tools) + 새 서비스 내림(전환 전부터 켜져 있었으면 그대로), 옛 서비스는 그대로.
  rollback --id <되돌리기 id> --version <V0> --config <config-live/설정> --status-dir <상태 폴더> --service <대상 서비스> --old-service <옛 서비스>
           [--drs <drs:…>] [--url …] [--case-file …] [--wait …]
      운영 되돌리기(D-140 안 A) — 이미 등록된 버전으로 전환. fetch · V-17 없음(새 태그가 아님, V-17은 register에만).
      (deploy-tools 안 restore-check) 1 운영 설정 · expect_revision(seed로 채운 것)   2 되돌리기 id 파일(switched · 다른 배포 id면 멈춤)
                        · 지금 운영(switched 중 updated_at 시각이 가장 늦은 것 = 대상이면 멈춤, 상태 폴더 없음 · 못 읽는 상태 파일 ·
                          같은 시각에 배포가 갈림이면 판단할 수 없어 멈춤)
                        3 Pack 캐시 태그 commit(읽기만)   4 V-04 → registered / failed "배포단 등록 실패 — …"
      그 뒤는 switch와 같음(--old-service 필수 — 되돌린 뒤 두 버전이 함께 상주하지 않게).
  reconfigure --service <배포 서비스> --config <config-live/설정> --template <config/새 설정> --case-file <C01 입력 JSON> [--url …] [--wait …]
      같은 서비스 · 같은 장부 줄에서 운영 설정만 바꿈(D-375, 예: 단계 B store 줄 flat-local → pgvector): 0 지금 /info(배포 id · revision · drs)
      → 1 안쪽 reconfigure-apply(템플릿 + 지금 expect_revision · 배포 id · Pack 저장소 · ref · revision 같은지 · 묶기 대조 → 옛 글
      .<설정>.before-reconfigure · 운영 설정 바꿈, 같은 글이면 손 0) → 2 restart → 3 /info 배포 id · revision · drs가 0과 같은지 → C01 201
      → 실패면 안쪽 reconfigure-revert(옛 글) → 다시 restart. 상태 파일은 쓰지 않음(같은 버전).
  r12 --service <배포 서비스> --config <config-live/설정> --graph <graph> --node <retrieve@2 node> [--store history]
      [--inbox-dir <호스트 받은 편지 폴더, 기본 /srv/llmopsagent/r12-inbox/<서비스>>] [--loader-env <호스트 적재 비밀 파일>] [--ledger-cmd …] [--url …] [--wait …]
      VPS R12 한 번(D-325 W-1 · cron 10분 + flock이 깨움): 1 안쪽(deploy-tools + docker/compose.r12.yaml: data volume · 받은 편지 읽기만 · 적재 비밀 읽기만)
      에서 r12-update update → 2 운영 설정이 바뀌었으면 호스트가 그 서비스 compose restart → 3 /info drs 대조, 다르거나 응답 없으면 안쪽 r12-revert
      (옛 설정) → 다시 restart. 새 보고서 없음 = 서비스 손 0.
바꿀 수 있는 명령(시험은 가짜): DEPLOY_CHECK_COMPOSE(기본 "docker compose -f <이 저장소>/docker/compose.yaml"),
  DEPLOY_CHECK_TOOLS(기본 "<compose> run --rm --no-deps --build deploy-tools python scripts/vps/deploy-check --inner"),
  DEPLOY_CHECK_EXEC(기본 "<compose> exec -T {service} python scripts/vps/deploy-check --inner"), DEPLOY_CHECK_GIT(안쪽 fetch, 기본 "git"),
  DEPLOY_CHECK_KEY_DIR(안쪽 fetch 열쇠 폴더, 기본 /run/keys — Pack 캐시 이름 → 열쇠 표 PACK_KEYS, V-4),
  DEPLOY_CHECK_BIND(안쪽 묶기 대조, 기본 "<python> scripts/r12-update" — 뒤에 check --config <운영 설정>을 붙임),
  DEPLOY_CHECK_R12_TOOLS(기본 "<compose> -f docker/compose.r12.yaml --profile tools run --rm --no-deps deploy-tools python scripts/vps/deploy-check --inner"),
  DEPLOY_CHECK_R12(안쪽 R12 작업, 기본 "<python> scripts/r12-update"),
  DEPLOY_CHECK_LEDGER(r12 --ledger-at-host의 장부 요청, 기본 "<compose> exec -T -e LLMOPS_STORE=pg llmops python -m llmops.admin data-release-auto
  --deployment-id {deployment_id} --pack-revision {pack_revision} --drs {drs} --evidence -" — 증거 JSON은 stdin, G-5 · D-328).
빌드 태그: DEPLOY_TAG · PACKRT_TAG(호스트 환경 변수, deploy-tools도 이 태그로 빌드). 비밀 값은 출력하지 않습니다.
종료: 0 완료 / 1 멈춤(이유 출력) / 2 사용 오류(아무것도 쓰지 않음)."""
import argparse
import json
import os
import re
import shlex
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

HERE = Path(__file__).resolve().parents[2]
ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:\-]{0,63}$")
REV_LINE = re.compile(r'^  expect_revision: "(sha256:[0-9a-f]{64})"', re.M)
STEP4 = "운영 전환 실패 — "


# ---------------------------------------------------------------- 공통(표준 라이브러리)
def out(msg):
    print(msg, flush=True)


def run(argv, **kw):
    return subprocess.run(argv, capture_output=True, text=True, **kw)


def last_line(text):
    lines = [l for l in (text or "").strip().splitlines() if l.strip()]
    return lines[-1][:200] if lines else ""


def cmd(env, default):
    return shlex.split(os.environ.get(env) or default)


# V-4(D-366 (가)): GitHub deploy key는 저장소마다 하나 — 열쇠 둘을 함께 주면 GitHub이 첫 열쇠로 인증한 뒤 '저장소 없음'으로 끝남.
# 그래서 안쪽 fetch가 Pack 캐시 이름으로 열쇠를 고름. 표에 없는 캐시는 compose의 GIT_SSH_COMMAND(열쇠 ② pack_read) 그대로.
PACK_KEYS = {"c1a15-pack": "c1a15_pack_read"}   # 열쇠 ⑦(c1a15-pack read-only, VPS /srv/llmopsagent/keys/c1a15_pack_read → deploy-tools /run/keys)


def pack_git_env(repo):
    """(환경, 멈춤 이유). 표에 있는 캐시면 그 열쇠만 쓰는 GIT_SSH_COMMAND(호스트 키 확인 그대로), 열쇠 파일이 없으면 멈춤."""
    name = PACK_KEYS.get(Path(repo).name)
    if not name:
        return None, None
    key = Path(os.environ.get("DEPLOY_CHECK_KEY_DIR") or "/run/keys") / name
    if not key.is_file():
        return None, f"{Path(repo).name} 읽기 열쇠 {key}가 없음(compose deploy-tools 붙이기 · VPS 열쇠 파일 확인)"
    return {**os.environ, "GIT_SSH_COMMAND": f"ssh -i {key} -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes"}, None


def atomic_write(p, text):
    p = Path(p)
    tmp = p.with_name(f".{p.name}.tmp-{os.getpid()}")      # 임시 파일 → rename(원자적, 같은 폴더)
    tmp.write_text(text, encoding="utf-8")
    os.replace(tmp, p)


def fill_expect_revision(config, revision):
    """설정 파일의 pack.expect_revision 한 칸만 바꾼다(주석 줄이면 값 줄로, 이미 같으면 그대로). 다른 줄은 그대로."""
    p = Path(config)
    text = p.read_text(encoding="utf-8")
    line = f'  expect_revision: "{revision}"   # 태그 알림 값 — scripts/vps/deploy-check register(V-17 뒤)'
    if re.search(rf'^  expect_revision: "{re.escape(revision)}"', text, re.M):
        return "그대로(이미 같음)"
    new, n = re.subn(r"^  #? ?expect_revision:.*$", line, text, count=1, flags=re.M)
    if n == 0:
        new, n = re.subn(r"^(  pack_subdir: .*)$", r"\1\n" + line, text, count=1, flags=re.M)
    if n == 0:
        raise SystemExit(f"설정에 expect_revision을 넣을 자리가 없음: {p.name}")
    atomic_write(p, new)
    return "채움"


# ---------------------------------------------------------------- 호스트 쪽(표준 라이브러리만, 저장소 뿌리를 sys.path에 넣지 않음)
def compose_cmd():
    return cmd("DEPLOY_CHECK_COMPOSE", f"docker compose -f {shlex.quote(str(HERE / 'docker' / 'compose.yaml'))}")


def tools_runner():
    default = " ".join(shlex.quote(c) for c in compose_cmd()) + " run --rm --no-deps --build deploy-tools python scripts/vps/deploy-check --inner"
    return cmd("DEPLOY_CHECK_TOOLS", default)


def exec_runner(service):
    default = " ".join(shlex.quote(c) for c in compose_cmd()) + " exec -T {service} python scripts/vps/deploy-check --inner"
    return [c.replace("{service}", service) for c in cmd("DEPLOY_CHECK_EXEC", default)]


def inner(runner, sub, *args, show=True):
    r = run([*runner, sub, *args])
    if show and r.stdout.strip():
        out(r.stdout.rstrip())
    return r


def need_tags():
    missing = [n for n in ("DEPLOY_TAG", "PACKRT_TAG", "DEPLOY_COMMIT") if not os.environ.get(n)]
    if missing:
        out(f"멈춤: 빌드 태그 환경 변수가 비어 있음({' · '.join(missing)}) — 아무것도 하지 않음")
        return False
    if not re.fullmatch(r"[0-9a-f]{40}", os.environ["DEPLOY_COMMIT"]):   # F-10 ②: 빌드가 받은 태그 commit과 대조할 값
        out(f"멈춤: DEPLOY_COMMIT은 deploy 태그의 40자 commit이어야 함(받은 값 {len(os.environ['DEPLOY_COMMIT'])}자) — 아무것도 하지 않음")
        return False
    return True


def port_of(service):
    """compose config --format json <서비스>(정규화된 긴 문법)에서 127.0.0.1에 연 포트. 서비스를 이름으로 주면 profile(standby)이어도 나옴."""
    r = run([*compose_cmd(), "config", "--format", "json", service])
    try:
        svc = (json.loads(r.stdout or "{}").get("services") or {}).get(service) or {}
    except ValueError:
        svc = {}
    for p in svc.get("ports") or []:
        if isinstance(p, dict):
            host, pub = str(p.get("host_ip") or ""), str(p.get("published") or "")
        else:
            parts = str(p).split(":")
            host, pub = (parts[0], parts[1]) if len(parts) == 3 else ("", "")
        if host == "127.0.0.1" and pub.isdigit():
            return int(pub)
    raise SystemExit(f"compose에서 {service}의 127.0.0.1 포트를 찾지 못함 — --url을 주세요")


def wait_up(url, timeout=120):
    end = time.time() + timeout
    while time.time() < end:
        try:
            urllib.request.urlopen(f"{url}/runs/run_ping", timeout=5)
            return True
        except urllib.error.HTTPError as e:
            if e.code == 404:          # 서버가 켜져 응답함(없는 run)
                return True
        except (urllib.error.URLError, OSError):
            pass
        time.sleep(1)
    return False


def post_c01(url, body, key):
    req = urllib.request.Request(f"{url}/runs", method="POST", data=json.dumps(body, ensure_ascii=False).encode(),
                                 headers={"Content-Type": "application/json", "Idempotency-Key": key})
    try:
        with urllib.request.urlopen(req, timeout=180) as r:
            return r.status, json.loads(r.read() or b"{}")
    except urllib.error.HTTPError as e:
        try:
            return e.code, json.loads(e.read() or b"{}")
        except ValueError:
            return e.code, {}


def host_register(a):
    if not need_tags():
        return 2
    args = ["--id", a.id, "--version", a.version, "--tag", a.tag, "--commit", a.commit, "--revision", a.revision,
            "--config", a.config, "--status-dir", a.status_dir, "--drs", a.drs]
    if a.template:
        args += ["--template", a.template]
    out("(deploy-tools 안에서 확인)")
    r = inner(tools_runner(), "register", *args)
    if r.returncode == 1 and r.stderr.strip():
        out(f"  (안쪽 오류) {last_line(r.stderr)}")
    if r.returncode not in (0, 1):
        out(f"멈춤: deploy-tools 오류(종료 {r.returncode}) — {last_line(r.stderr) or '(출력 없음)'}")
        return 1
    return r.returncode


def host_seed(a):
    if not need_tags():
        return 2
    r = inner(tools_runner(), "seed", "--config", a.config, "--template", a.template)
    if r.returncode and not r.stdout.strip():
        out(f"멈춤: deploy-tools 오류(종료 {r.returncode}) — {last_line(r.stderr) or '(출력 없음)'}")
    return 0 if r.returncode == 0 else 1


def host_rollback(a):
    if not need_tags():
        return 2
    args = ["--id", a.id, "--version", a.version, "--config", a.config, "--status-dir", a.status_dir, "--drs", a.drs]
    out("(deploy-tools 안에서 되돌리기 확인)")
    r = inner(tools_runner(), "restore-check", *args)
    if r.returncode == 1 and r.stderr.strip():
        out(f"  (안쪽 오류) {last_line(r.stderr)}")
    if r.returncode not in (0, 1):
        out(f"멈춤: deploy-tools 오류(종료 {r.returncode}) — {last_line(r.stderr) or '(출력 없음)'}")
        return 1
    if r.returncode:
        return 1
    return host_switch(a)


def r12_runner():
    """R12 일회용 실행(D-325 W-1): deploy-tools에 덧파일 compose.r12.yaml(data volume · 받은 편지 · 적재 비밀)을 더해 부름. 빌드는 하지 않음(지금 이미지)."""
    default = (" ".join(shlex.quote(c) for c in compose_cmd()) + f" -f {shlex.quote(str(HERE / 'docker' / 'compose.r12.yaml'))}"
               " --profile tools run --rm --no-deps deploy-tools python scripts/vps/deploy-check --inner")
    return cmd("DEPLOY_CHECK_R12_TOOLS", default)


def data_volume_of(service):
    """compose config --format json <서비스>에서 /var/lib/deploy/data에 붙은 named volume 이름(없으면 None)."""
    r = run([*compose_cmd(), "config", "--format", "json", service])
    try:
        svc = (json.loads(r.stdout or "{}").get("services") or {}).get(service) or {}
    except ValueError:
        return None
    for v in svc.get("volumes") or []:
        if isinstance(v, dict) and v.get("target") == "/var/lib/deploy/data" and v.get("type") == "volume":
            return v.get("source")
    return None


def get_info(url):
    with urllib.request.urlopen(f"{url}/info", timeout=10) as r:
        return json.loads(r.read() or b"{}")


R12_MARK = "R12 결과: "
R12_PENDING = "R12 대기: "   # r12-update --until-ledger 출력(장부 요청 증거)


def ledger_cmd_host():
    default = (" ".join(shlex.quote(c) for c in compose_cmd()) + " exec -T -e LLMOPS_STORE=pg llmops python -m llmops.admin data-release-auto"
               " --deployment-id {deployment_id} --pack-revision {pack_revision} --drs {drs} --evidence -")
    return os.environ.get("DEPLOY_CHECK_LEDGER") or default


def host_ledger(a, runner, env, res):
    """G-5: 장부 요청(llmops data-release-auto, 증거 JSON = stdin) → 성공이면 안쪽 r12-after-ledger, 실패면 r12-abort-ledger(운영 설정 그대로)."""
    cmd = ledger_cmd_host().format(deployment_id=shlex.quote(res["deployment_id"]), pack_revision=shlex.quote(res.get("pack_revision") or ""),
                                   drs=shlex.quote(res["drs"]))
    out(f"[1b/3] 장부 요청(llmops data-release-auto) · drs {res['drs']}")
    lr = run(shlex.split(cmd), input=json.dumps(res["evidence"], ensure_ascii=False))
    if lr.stdout.strip():
        out("  " + last_line(lr.stdout))
    if lr.returncode:
        why = last_line(lr.stdout + "\n" + lr.stderr) or f"종료 {lr.returncode}"
        ab = run([*runner, "r12-abort-ledger", "--config", a.config, "--reason", why[:200]], env=env)
        if ab.stdout.strip():
            out(ab.stdout.rstrip())
        out(f"결과: 멈춤 — 장부 요청 실패(종료 {lr.returncode}: {why}) · 운영 설정 · 서비스 그대로")
        return None
    r = run([*runner, "r12-after-ledger", "--config", a.config], env=env)
    if r.stdout.strip():
        out(r.stdout.rstrip())
    line = next((l for l in reversed(r.stdout.splitlines()) if l.startswith(R12_MARK)), None)
    if line is None:
        out(f"멈춤: 장부 뒤 R12 작업이 결과를 내지 못함(종료 {r.returncode}) — {last_line(r.stderr) or '(출력 없음)'}. 장부 줄은 쓰였음 — 확인해 주세요")
        return None
    return json.loads(line[len(R12_MARK):])


def host_r12(a):
    """VPS R12 한 번(D-325 W-1 · Q-1 (가)): 안쪽(deploy-tools + 덧파일)에서 r12-update update → 운영 설정이 바뀌었으면 호스트가 그 서비스를
    compose restart → 응답 · /info drs = 작업 기록 drs 대조 → 맞지 않으면 안쪽 r12-revert(옛 설정) → 다시 restart(W-3). 새 보고서 없으면 손 0."""
    vol = data_volume_of(a.service)
    if not vol:
        out(f"멈춤: compose에서 {a.service}의 data volume(/var/lib/deploy/data)을 찾지 못함 — 아무것도 하지 않음")
        return 1
    inbox = a.inbox_dir or f"/srv/llmopsagent/r12-inbox/{a.service}"
    if not Path(inbox).is_dir():   # 없는 호스트 폴더를 붙이면 Docker가 root 빈 폴더를 만듦 — 먼저 멈춤
        out(f"멈춤: 받은 편지 폴더 {inbox}가 없음(앱 쪽 붙이기 · D-325 Q-2 (ㄱ)) — 아무것도 하지 않음")
        return 1
    if a.loader_env and not Path(a.loader_env).is_file():
        out(f"멈춤: 적재 비밀 파일 {a.loader_env}가 없음(사용자 손) — 아무것도 하지 않음")
        return 1
    env = {**os.environ, "R12_DATA_VOLUME": vol, "R12_INBOX_DIR": inbox, "R12_LOADER_ENV": a.loader_env or "/dev/null"}
    runner = r12_runner()
    args = ["--config", a.config, "--store", a.store, "--graph", a.graph, "--node", a.node]
    args += ["--with-loader"] if a.loader_env else []
    args += ["--ledger-cmd", a.ledger_cmd] if a.ledger_cmd else []
    args += ["--ledger-at-host"] if a.ledger_at_host else []
    out(f"[1/3] R12 작업(deploy-tools · volume {vol} · 받은 편지 {inbox} · 적재 비밀 {'있음' if a.loader_env else '없음'})")
    r = run([*runner, "r12", *args], env=env)
    if r.stdout.strip():
        out(r.stdout.rstrip())
    line = next((l for l in reversed(r.stdout.splitlines()) if l.startswith(R12_MARK)), None)
    if line is None:
        out(f"멈춤: R12 작업이 결과를 내지 못함(종료 {r.returncode}) — {last_line(r.stderr) or '(출력 없음)'}. 운영 설정 · 서비스 그대로")
        return 1
    res = json.loads(line[len(R12_MARK):])
    if res.get("status") == "awaiting_ledger":   # G-5(D-328 Q-2 (가)): 장부는 호스트가 llmops 컨테이너에서(증거 = stdin)
        res = host_ledger(a, runner, env, res)
        if res is None:
            return 1
    if res.get("status") == "no_news":
        out("결과: 새 보고서 없음 — 서비스 그대로")
        return 0
    if res.get("status") not in ("restart_needed", "config_changed"):
        out(f"결과: 멈춤 — 운영 설정 그대로({res.get('status')}: {str(res.get('reason') or '')[:200]})")
        return 1
    compose = compose_cmd()
    url = a.url or f"http://127.0.0.1:{port_of(a.service)}"

    def restart_and_check():
        rr = run([*compose, "restart", a.service])
        if rr.returncode:
            return f"restart 종료 {rr.returncode}"
        if not wait_up(url, a.wait):
            return f"응답 없음({a.wait}초)"
        try:
            got = get_info(url).get("data_release_id")
        except Exception as e:      # 연결 끊김 · JSON 아님
            return f"/info 오류({type(e).__name__})"
        return None if got == res.get("drs") else f"drs 다름(서버 {got} · 작업 {res.get('drs')})"

    out(f"[2/3] 서비스 다시 시작: {a.service} → drs {res.get('drs')} · version {res.get('version')}")
    why = restart_and_check()
    if why is None:
        out(f"[3/3] /info drs 맞음 — 결과: R12 반영({a.service} · {res.get('version')})")
        return 0
    out(f"[3/3] 맞지 않음: {why} — 옛 설정으로 되돌림")
    rv = run([*runner, "r12-revert", "--config", a.config, "--reason", f"호스트 확인 실패: {why}"[:200]], env=env)
    if rv.stdout.strip():
        out(rv.stdout.rstrip())
    if rv.returncode:
        out(f"결과: 멈춤 — 되돌리기 실패(종료 {rv.returncode}) · 서비스는 새 설정 그대로일 수 있음. 손으로 확인해 주세요")
        return 1
    back = run([*compose, "restart", a.service])
    up = back.returncode == 0 and wait_up(url, a.wait)
    if res.get("ledger_drs"):   # G-2(D-328 Q-3 (가)): 장부 줄은 먼저 썼으므로 남음 — 알림
        out(f"주의: 장부에 쓴 R12 줄(drs {res['ledger_drs']})이 돌지 않음 — 다음 배포 승인 전에 확인(오케 · llmops 알림)")
    out("결과: 멈춤 — 옛 설정으로 되돌려 다시 띄움" if up else "결과: 멈춤 — 옛 설정으로 되돌렸으나 서비스가 응답하지 않음. 손으로 확인해 주세요")
    return 1


RECONF_MARK = "RECONF 결과: "


def host_reconfigure(a):
    """D-375: 같은 서비스 · 같은 장부 줄에서 운영 설정만 바꿈 + 자동 되돌림(R12 W-3 틀)."""
    if not need_tags():
        return 2
    if not Path(a.case_file).is_file():
        out(f"멈춤: C01 입력 파일 {a.case_file}가 없음 — 아무것도 하지 않음")
        return 1
    compose, tools = compose_cmd(), tools_runner()
    url = a.url or f"http://127.0.0.1:{port_of(a.service)}"
    try:
        before = get_info(url)
    except Exception as e:      # 서비스가 안 떠 있음 — 운영 중인 서비스만 바꿈
        out(f"멈춤: {a.service}가 응답하지 않음({type(e).__name__}) — 아무것도 하지 않음")
        return 1
    key = (before.get("deployment_id"), (before.get("pack") or {}).get("pack_revision"), before.get("data_release_id"))
    out(f"[0/4] 지금: {key[0]} · revision {str(key[1])[:15]} · drs {key[2]}")
    out("(deploy-tools 안에서 바꿀 설정 확인)")
    r = inner(tools, "reconfigure-apply", "--config", a.config, "--template", a.template)
    line = next((l for l in reversed(r.stdout.splitlines()) if l.startswith(RECONF_MARK)), None)
    if r.returncode or line is None:
        if r.stderr.strip():
            out(f"  (안쪽 오류) {last_line(r.stderr)}")
        out("결과: 멈춤 — 운영 설정 · 서비스 그대로")
        return 1
    res = json.loads(line[len(RECONF_MARK):])
    if res.get("status") == "same":
        out("결과: 운영 설정이 이미 템플릿과 같음 — 서비스 그대로")
        return 0

    def check():
        rr = run([*compose, "restart", a.service])
        if rr.returncode:
            return f"restart 종료 {rr.returncode}"
        if not wait_up(url, a.wait):
            return f"응답 없음({a.wait}초)"
        try:
            info = get_info(url)
        except Exception as e:
            return f"/info 오류({type(e).__name__})"
        got = (info.get("deployment_id"), (info.get("pack") or {}).get("pack_revision"), info.get("data_release_id"))
        if got != key:
            return f"배포 id · revision · drs가 바뀜(전 {key[0]} · {key[2]} / 뒤 {got[0]} · {got[2]}) — 같은 장부 줄이 아님"
        try:
            body = json.loads(Path(a.case_file).read_text(encoding="utf-8"))
            code, resp = post_c01(url, body, f"deploy-check-reconfigure-{int(time.time())}")
        except Exception as e:
            return f"C01 요청 오류({type(e).__name__})"
        out(f"[3/4] /info 같음 · C01 → {code} {resp.get('run_id') or ''}")
        return None if code == 201 else f"C01 응답 {code}"

    out(f"[2/4] 서비스 다시 시작: {a.service}(운영 설정 바꿈 — 옛 글 {res.get('before')})")
    why = check()
    if why is None:
        out(f"[4/4] 결과: 운영 설정 바꿈 반영({a.service} · drs {key[2]} 그대로)")
        return 0
    out(f"[4/4] 맞지 않음: {why} — 옛 설정으로 되돌림")
    rv = inner(tools, "reconfigure-revert", "--config", a.config)
    if rv.returncode:
        out(f"결과: 멈춤 — 되돌리기 실패(종료 {rv.returncode}) · 서비스는 새 설정일 수 있음. 손으로 확인해 주세요")
        return 1
    back = run([*compose, "restart", a.service])
    up = back.returncode == 0 and wait_up(url, a.wait)
    out("결과: 멈춤 — 옛 설정으로 되돌려 다시 띄움" if up else "결과: 멈춤 — 옛 설정으로 되돌렸으나 서비스가 응답하지 않음. 손으로 확인해 주세요")
    return 1


def host_switch(a):
    if not need_tags():
        return 2
    tools = tools_runner()
    base = ["--id", a.id, "--version", a.version, "--config", a.config, "--status-dir", a.status_dir]
    r = inner(tools, "precheck", *base)
    if r.returncode:
        if r.stderr.strip():
            out(f"  (안쪽 오류) {last_line(r.stderr)}")
        if not r.stdout.strip():
            out(f"멈춤: deploy-tools 오류(종료 {r.returncode}) — {last_line(r.stderr) or '(출력 없음)'}")
        return 1
    compose = compose_cmd()
    url = a.url or f"http://127.0.0.1:{port_of(a.service)}"
    before = run([*compose, "ps", "--status", "running", "--quiet", a.service])
    if before.returncode == 0 and before.stdout.strip():
        out(f"주의: {a.service}가 이미 켜져 있음 — 실패해도 내리지 않음(운영 중일 수 있음)")
        stop_new = False
    else:
        stop_new = True

    def failed(detail):
        if stop_new:
            s = run([*compose, "stop", a.service])
            out(f"새 서비스 내림: {a.service} (종료 {s.returncode})")
        inner(tools, "mark-failed", *base, "--detail", (STEP4 + detail)[:200])
        out("결과: 멈춤 — 새 서비스는 내리고 옛 서비스는 그대로 운영" if stop_new else "결과: 멈춤 — 옛 서비스는 그대로 운영")
        return 1

    out(f"[2/5] 새 서비스 빌드 · 기동: {a.service} (DEPLOY_TAG {os.environ['DEPLOY_TAG']} · PACKRT_TAG {os.environ['PACKRT_TAG']})")
    for step in (["build", a.service], ["up", "-d", a.service]):
        r = run([*compose, *step])
        if r.returncode:
            out(f"  {step[0]} 오류: {last_line(r.stderr) or '(출력 없음)'}")
            return failed(f"새 서비스가 켜지지 않음({step[0]} 종료 {r.returncode})")
    if not wait_up(url, a.wait):
        return failed(f"새 서비스가 응답하지 않음({a.wait}초)")
    try:
        if a.case_file:
            body = json.loads(Path(a.case_file).read_text(encoding="utf-8"))
        else:
            r = inner(exec_runner(a.service), "c01-input", "--config", a.config, show=False)
            if r.returncode:
                raise RuntimeError(last_line(r.stderr) or f"종료 {r.returncode}")
            body = json.loads(r.stdout)
        code, resp = post_c01(url, body, f"deploy-check-{a.id}-C01-{int(time.time())}")
    except Exception as e:      # 입력 못 만듦 · 연결 끊김 · 시간 초과 · JSON 아님 — 모두 ④ 실패로 남김(V-32 b)
        return failed(f"C01 요청 오류({type(e).__name__})")
    rid = resp.get("run_id") or (resp.get("error") or {}).get("run_id")
    out(f"[3/5] C01 → {code} {rid or ''}")
    if code != 201 or not rid:
        return failed(f"C01 응답 {code}")
    r = inner(exec_runner(a.service), "mark-switched", *base, "--run-id", rid, show=False)
    out(f"[4/5] 상태 파일: {r.stdout.strip() or last_line(r.stderr)}")
    if r.returncode not in (0, 1):     # exec 자체 실패 · 사용 오류 — deploy-status가 failed를 쓰지 못했으므로 deploy-tools에서 씀
        return failed(f"switched 기록 실패(종료 {r.returncode})")
    if r.returncode and inner(tools, "precheck", *base, show=False).returncode == 0:
        return failed("switched 기록 실패(종료 1, 상태 그대로 registered)")   # 안쪽이 failed를 못 쓴 채 끝남 — deploy-tools에서 씀
    if r.returncode:                   # 1 = deploy-status가 대조 실패로 failed를 이미 씀
        if stop_new:
            s = run([*compose, "stop", a.service])
            out(f"새 서비스 내림: {a.service} (종료 {s.returncode})")
        out("결과: 멈춤 — 상태 파일 failed(④), 옛 서비스는 그대로 운영")
        return 1
    if a.old_service:
        r = run([*compose, "stop", a.old_service])
        out(f"[5/5] 옛 서비스 내림: {a.old_service} (종료 {r.returncode})")
        if r.returncode:
            out("주의: 옛 서비스를 내리지 못함 — 운영은 새 서비스(switched). 손으로 내려 주세요")
    else:
        out("[5/5] 옛 서비스 없음")
    out("결과: switched(④ 완료)")
    return 0


