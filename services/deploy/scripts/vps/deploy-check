        p.add_argument("--status-dir", required=True)
        if name == "register":
            p.add_argument("--template")
            p.add_argument("--tag", required=True)
            p.add_argument("--commit", required=True)
            p.add_argument("--revision", required=True)
            p.add_argument("--drs", default="drs:54e2537743f7fa9c")
        else:
            p.add_argument("--service", required=True)
            p.add_argument("--old-service", required=(name == "rollback"))   # 되돌린 뒤 두 버전이 함께 상주하지 않게(PRS-07)
            if name == "rollback":
                p.add_argument("--drs", default="drs:54e2537743f7fa9c")
            p.add_argument("--url")
            p.add_argument("--case-file")
            p.add_argument("--wait", type=int, default=120)
    p = sub.add_parser("r12")
    p.add_argument("--service", required=True)
    p.add_argument("--config", required=True)
    p.add_argument("--store", default="history")
    p.add_argument("--graph", required=True)
    p.add_argument("--node", required=True)
    p.add_argument("--inbox-dir")
    p.add_argument("--loader-env")
    p.add_argument("--ledger-cmd")
    p.add_argument("--ledger-at-host", action="store_true", help="G-5: 장부를 호스트가 llmops 컨테이너에서 씀(VPS 장부 대조 llmops_pg)")
    p.add_argument("--url")
    p.add_argument("--wait", type=int, default=120)
    p = sub.add_parser("reconfigure")   # D-375: 같은 서비스 · 같은 장부 줄에서 운영 설정만 바꿈
    p.add_argument("--service", required=True)
    p.add_argument("--config", required=True)
    p.add_argument("--template", required=True)
    p.add_argument("--case-file", required=True)
    p.add_argument("--url")
    p.add_argument("--wait", type=int, default=120)
    a = ap.parse_args(argv)
    for v in (a.config, getattr(a, "template", None)):
        if v and v.startswith("/srv/"):
            print(f"사용 오류: {v}는 호스트 경로 — 컨테이너 안 경로(config-live/… · config/…)를 주세요", file=sys.stderr)
            return 2
    if a.cmd == "seed":
        return host_seed(a)
    if a.cmd == "r12":
        return host_r12(a)
    if a.cmd == "reconfigure":
        return host_reconfigure(a)
    if not ID_RE.fullmatch(a.id) or not re.fullmatch(r"V\d+", a.version):
        print("사용 오류: --id(change id) · --version(V1, V2 …) 모양", file=sys.stderr)
        return 2
    if a.cmd in ("switch", "rollback") and a.old_service and a.old_service == a.service:
        print("사용 오류: --old-service가 --service와 같음(방금 켠 운영 서비스를 내리게 됨)", file=sys.stderr)
        return 2
    if a.cmd == "register":
        if not re.fullmatch(r"[0-9a-f]{40}", a.commit) or not re.fullmatch(r"sha256:[0-9a-f]{64}", a.revision) or not re.fullmatch(r"v\d+", a.tag):
            print("사용 오류: --commit 40자 · --revision sha256:<64자> · --tag v<n>", file=sys.stderr)
            return 2
        return host_register(a)
    if a.cmd == "rollback":
        return host_rollback(a)
    return host_switch(a)


