LEDGER_ENV_NAMES = ["LLMOPSAGENT_RUNTIME_DSN"]   # deploy-tools 장부 접속 파일에 허용하는 이름(D-146 — runtime_reader 하나만)


def inner_ledger_env_problem(s):
    """registration llmops_pg일 때 장부 접속 파일(runtime_db.env_file)이 runtime_reader DSN 한 이름만 담았는지 — 이름만 읽고 값은 읽지 · 내지 않음.
    문제가 있으면 한 줄 이유, 없으면 None. 파일이 없으면 V-04가 판단(환경 변수일 수 있음)."""
    if s.registration.get("mode") != "llmops_pg" or not s.runtime_db.get("env_file"):
        return None
    p = Path(s.runtime_db["env_file"])
    if p.is_dir():
        return f"장부 접속 파일 자리 {p}가 폴더임(VPS에 파일이 없을 때 Docker가 만든 빈 폴더 — 폴더를 지우고 deploy-tools.env를 만들어 주세요)"
    if not p.exists():
        return None
    try:
        names = [re.sub(r"^export\s+", "", l.strip()).partition("=")[0].strip() for l in p.read_text(encoding="utf-8").splitlines()
                 if l.strip() and not l.lstrip().startswith("#")]
    except OSError as e:
        return f"장부 접속 파일 {p.name}을 읽을 수 없음({type(e).__name__}) — 소유 uid 10001 · 600인지 확인해 주세요"
    if names != LEDGER_ENV_NAMES:
        return f"장부 접속 파일 {p.name}의 이름이 {names} — runtime_reader DSN 한 이름({LEDGER_ENV_NAMES[0]})만 둡니다(D-146)"
    return None


def inner_copy_template(config, template):
    """운영 설정이 없을 때만 이미지 설정을 복사(원자적). 있으면 그대로."""
    c = Path(config)
    if c.exists():
        return False
    if not template or not Path(template).is_file():
        raise SystemExit(f"멈춤: 운영 설정 {c.name}이 없고 복사할 이미지 설정(--template)도 없음")
    c.parent.mkdir(parents=True, exist_ok=True)
    atomic_write(c, Path(template).read_text(encoding="utf-8"))
    return True


def inner_register(a):
    if inner_stage(a).get("stage") == "switched":
        out("멈춤: 이 change id는 이미 switched(④ 완료) — 다시 등록하지 않음(상태 파일 그대로)")
        return 1
    if inner_copy_template(a.config, a.template):
        out(f"[0/5] 운영 설정 만듦: {Path(a.template).name} → {a.config}")
    else:
        out(f"[0/5] 운영 설정 그대로(이미 있음): {a.config}")
        if a.template and Path(a.template).is_file():
            strip = lambda s: [l for l in s.splitlines() if not re.match(r"^  #? ?expect_revision:", l)]
            if strip(Path(a.config).read_text(encoding="utf-8")) != strip(Path(a.template).read_text(encoding="utf-8")):
                out("  주의: 운영 설정이 이미지 설정과 다름(expect_revision 줄 말고) — 이전 시도에서 남은 것인지 확인해 주세요")
    s = inner_settings(a.config)
    bad = inner_ledger_env_problem(s)
    if bad:
        out(f"멈춤: {bad} — 상태 파일은 쓰지 않음(③ 대기)")
        return 1
    genv, bad = pack_git_env(s.pack_repo)
    out(f"[1/5] 태그 받기: {s.pack_repo.name} fetch --tags" + (f"(열쇠 {PACK_KEYS[s.pack_repo.name]})" if genv or bad else ""))
    if bad:
        out(f"멈춤: {bad} — 상태 파일은 쓰지 않음(③ 대기)")
        return 1
    r = run([*cmd("DEPLOY_CHECK_GIT", "git"), "-C", str(s.pack_repo), "fetch", "--tags", "origin"], env=genv)
    if r.returncode:
        out(f"멈춤: 태그를 받지 못함(종료 {r.returncode}) — 상태 파일은 쓰지 않음(③ 대기)")
        return 1
    out("[2/5] V-17")
    r = py("v17_check.py", "--config", a.config, "--commit", a.commit, "--revision", a.revision, "--tag", a.tag)
    out(r.stdout.strip())
    if r.returncode and inner_crashed(r):
        out(f"멈춤: V-17 도구 오류 — {last_line(r.stderr)}. 상태 파일은 쓰지 않음(③ 대기)")
        return 1
    if r.returncode and "Pack을 읽지 못함" in r.stdout:   # 이미지의 packrt가 이 Pack보다 옛 판(038 1-1, 넘김 H-12)
        out("멈춤: V-17 — 이 이미지가 Pack을 읽지 못함. 새 packrt 판 이미지로 먼저 다시 빌드(상태 파일은 쓰지 않음, ③ 대기)")
        return 1
    if r.returncode:
        out("멈춤: V-17 불일치 — 상태 파일은 쓰지 않음(③ 대기). 알림 값을 확인해 주세요")
        return 1
    out("[3/5] 묶기 대조(D-291 덧 — packrt가 이 설정으로 시작할 수 있는지 · 쓰기 0)")
    r = run([*cmd("DEPLOY_CHECK_BIND", f"{shlex.quote(sys.executable)} {shlex.quote(str(HERE / 'scripts' / 'r12-update'))}"), "check", "--config", a.config])
    out(r.stdout.strip())
    if r.returncode:
        why = f" — 도구 오류 {last_line(r.stderr)}" if inner_crashed(r) else ""
        out(f"멈춤: 묶기 대조 실패{why} — 상태 파일은 쓰지 않음(③ 대기). 서버가 이 설정으로 시작하지 못함(release · recipe · DB 줄 확인)")
        return 1
    out(f"[4/5] expect_revision: {fill_expect_revision(a.config, a.revision)} ({Path(a.config).name})")
    out("[5/5] V-04 장부 줄")
    r = py("es3_check.py", "--config", a.config, "--id", a.id, "--version", a.version, "--commit", a.commit,
           "--revision", a.revision, "--tag", a.tag, "--drs", a.drs, "--status-dir", a.status_dir)
    out(r.stdout.strip())
    stage = inner_stage(a).get("stage")
    if r.returncode == 0 and stage == "registered":
