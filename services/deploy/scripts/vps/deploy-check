        return 0
    if stage == "failed":
        out(f"결과: 멈춤(종료 {r.returncode}) — 상태 파일 failed(③)")
    else:
        out(f"결과: 멈춤 — V-04 도구 오류({last_line(r.stderr) or f'종료 {r.returncode}'}), 상태 파일 {stage or '없음'}")
    return 1


def read_status(p):
    """상태 파일 하나 → dict. JSON이 아니거나 updated_at이 시간대 있는 시각이 아니면 ValueError."""
    from datetime import datetime
    d = json.loads(p.read_text(encoding="utf-8"))
    if not isinstance(d, dict):
        raise ValueError("JSON 객체가 아님")
    at = datetime.fromisoformat(d.get("updated_at") or "")
    if at.tzinfo is None:
        raise ValueError("updated_at에 시간대가 없음")
    return d, at


def inner_restore_check(a):
    c = Path(a.config)
    s = inner_settings(a.config) if c.is_file() else None
    if s is None or not s.expect_revision:
        out(f"멈춤: 운영 설정 {a.config}이 없거나 expect_revision이 비어 있음 — seed를 먼저 돌려 주세요(상태 파일 · 서비스 그대로)")
        return 1
    bad = inner_ledger_env_problem(s)
    if bad:
        out(f"멈춤: {bad} — 상태 파일 · 서비스 그대로")
        return 1
    out(f"[1/4] 운영 설정: {c.name} · {s.deployment_id} · expect_revision {s.expect_revision[:15]}…")
    folder, mine = Path(a.status_dir), Path(a.status_dir) / f"{a.id}.json"
    if not folder.is_dir():          # 볼륨이 새로 생겼거나 경로가 틀림 — LLMOps가 못 보는 곳에 쓰고 V1을 내리지 않게(F-6, 답장 019-14 L0)
        out(f"멈춤: 상태 폴더 {a.status_dir}이 없음 — 지금 운영을 판단할 수 없음(상태 파일 · 서비스 그대로)")
        return 1
    found = {}
    for p in sorted(folder.glob("*.json")):
        try:
            found[p] = read_status(p)
        except (OSError, ValueError, TypeError) as e:
            out(f"멈춤: 상태 파일 {p.name}을 읽을 수 없음({e}) — 지금 운영을 판단할 수 없음(상태 파일 · 서비스 그대로)")
            return 1
    if mine in found:
        d = found[mine][0]
        out(f"[2/4] 되돌리기 id 상태: {d.get('stage')}({d.get('deployment_id')})")
        if d.get("deployment_id") != s.deployment_id:
            out(f"멈춤: 다른 배포의 상태 파일 — 덮지 않음(대상 {s.deployment_id}, 상태 파일 · 서비스 그대로)")
            return 1
        if d.get("stage") == "switched":
            out("멈춤: 이 되돌리기 id는 이미 switched(④ 완료) — 다시 하지 않음(상태 파일 그대로)")
            return 1
    else:
        out("[2/4] 되돌리기 id 상태: 없음")
    live = [(at, d) for d, at in found.values() if d.get("stage") == "switched"]
    latest = max((at for at, _ in live), default=None)
    tops = {d.get("deployment_id") for at, d in live if at == latest}
    if len(tops) > 1:                # 같은 시각에 배포 id가 다른 switched — 고를 근거가 없음(F-7, 답장 019-14 L0)
        out(f"멈춤: 같은 시각({latest.isoformat()})의 switched 파일이 배포 {', '.join(sorted(map(str, tops)))}로 갈림 — 지금 운영을 판단할 수 없음(상태 파일 · 서비스 그대로)")
        return 1
    now = tops.pop() if tops else None
    out(f"  지금 운영: {now or '없음'}")
    if now == s.deployment_id:
        out("멈춤: 이미 운영 중인 배포 — 되돌릴 것 없음(상태 파일 · 서비스 그대로)")
        return 1
    r = run([*cmd("DEPLOY_CHECK_GIT", "git"), "-C", str(s.pack_repo), "rev-parse", "--verify", "--quiet", f"refs/tags/{s.pack_ref}^{{commit}}"])
    commit = r.stdout.strip()
    if r.returncode or not re.fullmatch(r"[0-9a-f]{40}", commit):
        out(f"멈춤: Pack 캐시에 태그 {s.pack_ref}가 없음(fetch는 하지 않음) — 상태 파일은 쓰지 않음(③ 대기)")
        return 1
    out(f"[3/4] 태그 {s.pack_ref} → commit {commit[:12]}(Pack 캐시, fetch 없음)")
    out("[4/4] V-04 장부 줄")
    r = py("es3_check.py", "--config", a.config, "--id", a.id, "--version", a.version, "--commit", commit,
           "--revision", s.expect_revision, "--tag", s.pack_ref, "--drs", a.drs, "--status-dir", a.status_dir)
    out(r.stdout.strip())
    stage = inner_stage(a).get("stage")
    if r.returncode == 0 and stage == "registered":
        out("결과: registered(되돌리기 확인)")
        return 0
    if stage == "failed":
        out(f"결과: 멈춤(종료 {r.returncode}) — 상태 파일 failed(③)")
    else:
        out(f"결과: 멈춤 — V-04 도구 오류({last_line(r.stderr) or f'종료 {r.returncode}'}), 상태 파일 {stage or '없음'}")
    return 1


