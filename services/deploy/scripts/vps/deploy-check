R12_LOADER_IN = os.environ.get("DEPLOY_CHECK_R12_LOADER_IN", "/run/deploy/index-loader.env")   # compose.r12.yaml이 붙이는 자리(맥 예행은 바꿔 끼움)


def r12_cli():
    return cmd("DEPLOY_CHECK_R12", f"{shlex.quote(sys.executable)} {shlex.quote(str(HERE / 'scripts' / 'r12-update'))}")


def r12_result(sp, n0, r):
    """r12-update 한 번의 결과 한 줄: 장부 대기(R12 대기:) · 새 보고서 없음 · 작업 기록의 새 줄 · 기록 전에 멈춤."""
    pend = next((l for l in reversed(r.stdout.splitlines()) if l.startswith(R12_PENDING)), None)
    if r.returncode == 0 and pend:
        return {"status": "awaiting_ledger", **json.loads(pend[len(R12_PENDING):])}
    if r.returncode == 0 and "새 보고서 없음" in r.stdout:
        return {"status": "no_news"}
    hist = (json.loads(sp.read_text(encoding="utf-8")).get("history") or []) if sp.exists() else []
    if len(hist) > n0:
        h = hist[-1]
        return {k: h.get(k) for k in ("status", "drs", "version", "corpus", "reports", "reason", "ledger_drs")}
    return {"status": "failed", "reason": last_line(r.stdout) or last_line(r.stderr) or f"종료 {r.returncode}"}   # 기록 전에 멈춤(받은 편지 모양 등)


def inner_r12_step(a, args):
    s = inner_settings(a.config)
    sp = Path(s.data_dir) / "r12-state.json"
    n0 = len(json.loads(sp.read_text(encoding="utf-8")).get("history") or []) if sp.exists() else 0
    r = run([*r12_cli(), *args])
    if r.stdout.strip():
        out("\n".join(l for l in r.stdout.rstrip().splitlines() if not l.startswith(R12_PENDING)))
    res = r12_result(sp, n0, r)
    out(R12_MARK + json.dumps(res, ensure_ascii=False))
    return 0 if res["status"] in ("no_news", "awaiting_ledger", "restart_needed", "config_changed", "switched") else 1


def inner_r12(a):
    """안쪽 R12(D-325 W-1): r12-update update 한 번 → `R12 결과: …` 한 줄. --ledger-at-host면 장부 요청 앞에서 멈추고 증거를 냄(G-5, D-328 Q-2 (가))."""
    args = ["update", "--config", a.config, "--store", a.store, "--graph", a.graph, "--node", a.node]
    args += ["--loader-env-file", R12_LOADER_IN] if a.with_loader else []
    args += ["--ledger-cmd", a.ledger_cmd] if a.ledger_cmd else []
    args += ["--until-ledger"] if a.ledger_at_host else []
    return inner_r12_step(a, args)


