      "type": "number"
    },
    "ld_excess_std": {
      "type": "number"
    },
    "type_code": {
      "type": "number"
    },
    "air": {
      "type": "number"
    },
    "proc": {
      "type": "number"
    },
    "rpm": {
      "type": "number"
    },
    "torque": {
      "type": "number"
    },
    "wear": {
      "type": "number"
    }
