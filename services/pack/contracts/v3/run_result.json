{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "c1a15-pack/contracts/v3/run_result.json",
  "title": "RunResult",
  "description": "C1-a15 Pack Run 출력 v3 — v2 + report(보고서 cause · action 문장과 원문 대체 표시). 배포 서버 201 result.output 그대로(앱이 읽음, grounding_keys = [] — D-278)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "alarm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "alarm",
        "group",
        "group_source",
        "alarm_block",
        "sensor_derived",
        "ml",
        "candidate"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]{1,40}$"
        },
        "alarm": {
          "type": "boolean"
        },
        "group": {
          "enum": [
            "TW",
            "PW",
            "CL",
            "LD",
            null
          ]
        },
        "group_source": {
          "enum": [
            "sensor_boundary",
            "ml_type",
            null
          ]
        },
        "alarm_block": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sensor",
                "value",
                "unit",
                "boundary",
                "direction",
                "trend_title"
              ],
              "properties": {
                "sensor": {
                  "type": "string"
                },
                "value": {
                  "type": "number"
                },
                "unit": {
                  "type": "string"
                },
                "boundary": {
                  "type": "number"
                },
                "direction": {
                  "enum": [
                    "경계 위",
                    "경계 아래"
                  ]
                },
                "trend_title": {
                  "type": "string"
                }
              }
            }
          ],
          "description": "경계 판정 결과(앱 알람 행 alarm 칸과 같은 모양). 경계를 안 넘었으면 null"
        },
        "sensor_derived": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "power_w",
            "temp_diff_k"
          ],
          "properties": {
            "power_w": {
              "type": "number"
            },
            "temp_diff_k": {
              "type": "number"
            }
          }
        },
        "ml": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "model_release",
                "risk",
                "alarm",
                "top_k",
                "confidence",
                "threshold",
                "confirmed"
              ],
              "properties": {
                "model_release": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "risk": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "alarm": {
                  "type": "boolean"
                },
                "top_k": {
                  "type": "array",
                  "maxItems": 3,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "type",
                      "probability",
                      "group_suggestion"
                    ],
                    "properties": {
                      "type": {
                        "type": "string"
                      },
                      "probability": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "group_suggestion": {
                        "enum": [
                          "TW",
                          "PW",
                          "CL",
                          "LD",
                          null
                        ]
                      }
                    }
                  }
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "threshold": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "exclusiveMaximum": 1
                },
                "confirmed": {
                  "const": false
                },
                "group_source": {
                  "enum": [
                    "sensor_boundary",
                    "ml_type"
                  ]
                }
              }
            }
          ],
          "description": "source_mode = ml_predicted일 때 예측 요약(sensor_boundary면 null). 원인 순위 · 판정에는 쓰지 않음(D-238)"
        },
        "candidate": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reason",
                "risk",
                "top_k",
                "boundary_crossed",
                "model_release"
              ],
              "properties": {
                "reason": {
                  "enum": [
                    "low_confidence",
                    "rnf",
                    "model_failure"
                  ]
                },
                "risk": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "top_k": {
                  "type": "array",
                  "maxItems": 3,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "type",
                      "probability",
                      "group_suggestion"
                    ],
                    "properties": {
                      "type": {
                        "type": "string"
                      },
                      "probability": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "group_suggestion": {
                        "enum": [
                          "TW",
                          "PW",
                          "CL",
                          "LD",
                          null
                        ]
                      }
                    }
                  }
                },
                "boundary_crossed": {
                  "type": "boolean"
                },
                "model_release": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          ],
          "description": "알람 없이 사람 판단 거리로 기록만(Q-1 (나)) — 앱 ops.alarm_candidates"
        }
      }
    },
    "decision": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string"
        }
      },
      "description": "다음 단계 하나(앱 engine/session.decide와 같은 모양)"
    },
    "similar": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id",
          "score"
        ],
        "properties": {
          "record_id": {
            "type": "string"
          },
          "cause": {
            "type": [
              "string",
              "null"
            ]
          },
          "score": {
            "type": "number"
          }
        }
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "vector_db_version",
        "query_from",
        "top_k"
      ],
      "properties": {
        "source": {
          "enum": [
            "packrt",
            "request"
          ],
          "description": "request = P1 다리(start.similar를 그대로 씀)"
        },
        "vector_db_version": {
          "type": [
            "string",
            "null"
          ],
          "description": "이력 DB version(packrt release id). request면 null — 앱이 자기 임시 release id를 저장"
        },
        "query_from": {
          "enum": [
            "embed",
            "release",
            null
          ]
        },
        "top_k": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cause",
        "action"
      ],
      "properties": {
        "cause": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "fallback",
            "attempts",
            "reason"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "fallback": {
              "type": "boolean",
              "description": "true = 근거 검사를 두 번 통과하지 못해 원문(report_draft의 그 칸)으로 대체"
            },
            "attempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2
            },
            "reason": {
              "enum": [
                null,
                "ungrounded_section",
                "ungrounded_record",
                "ungrounded_number",
                "empty"
              ]
            }
          }
        },
        "action": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "fallback",
            "attempts",
            "reason"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "fallback": {
              "type": "boolean",
              "description": "true = 근거 검사를 두 번 통과하지 못해 원문(report_draft의 그 칸)으로 대체"
            },
            "attempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2
            },
            "reason": {
              "enum": [
                null,
                "ungrounded_section",
                "ungrounded_record",
                "ungrounded_number",
                "empty"
              ]
            }
          }
        }
      },
      "description": "LLM이 다시 쓴 보고서 문장 둘(나머지 6칸은 앱 초안 그대로라 돌려주지 않음)"
    }
  },
  "oneOf": [
    {
      "required": [
        "alarm"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "decision"
            ]
          },
          {
            "required": [
              "similar"
            ]
          },
          {
            "required": [
              "retrieval"
            ]
          },
          {
            "required": [
              "report"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "decision",
        "similar",
        "retrieval"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "alarm"
            ]
          },
          {
            "required": [
              "report"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "decision"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "alarm"
            ]
          },
          {
            "required": [
              "similar"
            ]
          },
          {
            "required": [
              "retrieval"
            ]
          },
          {
            "required": [
              "report"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "report"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "alarm"
            ]
          },
          {
            "required": [
              "decision"
            ]
          },
          {
            "required": [
              "similar"
            ]
          },
          {
            "required": [
              "retrieval"
            ]
          }
        ]
      }
    }
  ]
}
